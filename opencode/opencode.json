  "agent": {
    "build": {
      "mode": "primary",
      "model": "litellm/claude-4.8-opus"
    },
    "plan": {
      "mode": "primary",
      "model": "litellm/claude-4.8-opus"
    }
  },
  "permission": {
    "bash": {
      "rm *": "ask",
      "git *": "ask",
      "grep *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "open https://gitlab.quiq.sh/*": "allow",
      "git diff*": "allow",
      "echo *": "allow",
      "qdev *": "allow",
      "qdev *--yes*": "ask"
    },
    "edit": {
      "*": "ask",
      "*.scala": "allow",
      "*.java": "allow",
      "*.rs": "allow",
      "*.js": "allow",
      "*.jsx": "allow",
      "*.ts": "allow",
      "*.tsx": "allow",
      "*.gradle": "allow",
      "*.py": "allow",
      "*.md": "allow",
      "*.lua": "allow"
    },
    "read": {
      "*": "ask",
      "*.scala": "allow",
      "*.java": "allow",
      "*.rs": "allow",
      "*.js": "allow",
      "*.jsx": "allow",
      "*.ts": "allow",
      "*.tsx": "allow",
      "*.gradle": "allow",
      "*.py": "allow",
      "*.log": "allow",
      "*.md": "allow",
      "*.lua": "allow",
      "*.toml": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "config-override.json": "deny",
    },
    "list": {
      "*": "allow"
    },
    "task": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "external_directory": {
      "*": "ask",
      "~/Dev/quiq*": "allow"
    },
    "doom_loop": "deny",
    "skill": "allow"
  },
  "plugin": [
    "/Users/jared.weiss/.config/opencode/plugins/bash-restrictor",
    "oh-my-openagent",
    "opencode-agent-memory@0.2.0",
    ["@plannotator/opencode@0.19.16", {
      "workflow": "all-agents",
    }]
  ]

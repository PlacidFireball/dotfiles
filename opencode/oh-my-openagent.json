    "ultrabrain": {
      "model": "litellm/claude-4.6-sonnet"
    },
    "deep": {
      "model": "litellm/claude-4.6-sonnet"
    },
    "artistry": {
      "model": "litellm/claude-4.8-opus"
    },
    "quick": {
      "model": "litellm/claude-4.8-opus"
    },
    "unspecified-low": {
      "model": "litellm/claude-4.8-opus"
    },
    "unspecified-high": {
      "model": "litellm/claude-4.6-sonnet"
    },
    "writing": {
      "model": "litellm/claude-4.6-sonnet"
    }
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "tmux_visualization": true
